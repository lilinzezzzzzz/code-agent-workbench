{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-pty",
    "opencode-vibeguard"
  ],
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    }
  }
}
